{
  "name": "michimi",
  "private": true,
  "version": "0.1.0",
  "description": "Michimi \u2014 marketplace C2C confiable para Latinoam\u00e9rica (Paraguay por defecto)",
  "scripts": {
    "dev:web": "pnpm --filter @michimi/web dev",
    "dev:mobile": "pnpm --filter @michimi/mobile start",
    "build:web": "pnpm --filter @michimi/web build",
    "test": "pnpm --filter @michimi/core test",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/core/src/database.types.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "@opennextjs/aws>cookie": "0.7.2"
    }
  }
}