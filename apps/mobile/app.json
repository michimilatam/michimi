{
  "expo": {
    "name": "Michimi",
    "slug": "michimi",
    "scheme": "michimi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "bundleIdentifier": "com.michimi.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Michimi usa tus fotos para que publiques tus productos.",
        "NSCameraUsageDescription": "Michimi usa la cámara para que fotografíes tus productos."
      }
    },
    "android": {
      "package": "com.michimi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "www.michimi.com", "pathPrefix": "/publicacion" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      ["expo-image-picker", { "photosPermission": "Michimi usa tus fotos para que publiques tus productos." }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
